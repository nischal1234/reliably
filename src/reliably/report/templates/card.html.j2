<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reliability Report</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         margin: 40px; color: #222; background: #fafafa; }
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .meta { font-size: 0.8rem; color: #666; margin-bottom: 1.5rem; }
  table { border-collapse: collapse; width: 100%; max-width: 640px; }
  th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid #e0e0e0; }
  th { background: #f0f0f0; font-weight: 600; font-size: 0.85rem; }
  td { font-size: 0.9rem; font-family: "SF Mono", monospace; }
  .significant { color: #c0392b; font-weight: 600; }
  .ok { color: #27ae60; }
  .footer { margin-top: 2rem; font-size: 0.75rem; color: #aaa; }
</style>
</head>
<body>
<h1>Reliability Report</h1>
<p class="meta">
  Task: <strong>{{ report.task }}</strong> &nbsp;|&nbsp;
  N = <strong>{{ report.n }}</strong> &nbsp;|&nbsp;
  {% if report.meta.get('seed') is not none %}seed = {{ report.meta['seed'] }}{% endif %}
</p>

<table>
  <thead>
    <tr>
      <th>Metric</th>
      <th>Value</th>
      <th>95% CI</th>
      <th>n</th>
    </tr>
  </thead>
  <tbody>
    {% for name, mr in report.metrics.items() %}
    <tr>
      <td>{{ mr.name }}</td>
      <td>{{ "%.4f"|format(mr.value) }}</td>
      <td>
        {% if mr.ci %}
          [{{ "%.4f"|format(mr.ci.low) }}, {{ "%.4f"|format(mr.ci.high) }}]
        {% else %}
          —
        {% endif %}
      </td>
      <td>{{ mr.n }}</td>
    </tr>
    {% if mr.extra %}
      {% for k, v in mr.extra.items() %}
      <tr>
        <td style="padding-left:2em; color:#888">{{ k }}</td>
        <td>{{ "%.4f"|format(v) }}</td>
        <td></td><td></td>
      </tr>
      {% endfor %}
    {% endif %}
    {% endfor %}
  </tbody>
</table>

<p class="footer">Generated by <strong>reliably</strong> v{{ version }}</p>
</body>
</html>
